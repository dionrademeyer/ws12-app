# Copy to .env.local and fill in from the Supabase project settings (API section).
# Only the project URL and the publishable (anon) key belong here. They are safe in the browser
# because Row Level Security protects every table.
# Never put the service role key, payment secrets or AI keys in any VITE_ variable.
# Leave both empty to run the app in demo mode only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge function secrets. These never go in this file or in any VITE_ variable. Set them only as
# Supabase secrets (supabase secrets set NAME=value). Names only, see supabase/functions/README.md.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (provided by Supabase)
# ALLOWED_ORIGINS
# CONSENT_CONTACT_KEY
# CONSENT_SENDING_ENABLED
# PAYFAST_MODE
# PAYFAST_MERCHANT_ID
# PAYFAST_PASSPHRASE
# PAYFAST_ALLOWED_IPS
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
